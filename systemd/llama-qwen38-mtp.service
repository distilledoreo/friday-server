[Unit]
Description=Qwen3.8 27B llama-server for FRIDAY (127.0.0.1:8080)
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/assistant-server/llama/llama.env
ExecStart=%h/assistant-server/llama/start-server.sh
